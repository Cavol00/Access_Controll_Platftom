# Esempio: copiatelo in .env (che non va mai committato) e cambiate la chiave.
PORT=3000
DB_PATH=./data/access-control.sqlite
# Chiave che il lettore badge (oggi il simulatore) manda nell'header X-API-Key.
# In .env mettete una stringa lunga e casuale, per esempio generata con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIMULATOR_API_KEY=cambiami-con-una-chiave-casuale
